# When running locally with the sidecar on the same machine, leave defaults.
# When pointing at a RunPod-hosted sidecar, set this to its public URL.
SIDECAR_URL=http://localhost:8001

# Optional: PersonaPlex iframe URL for the live-audio + branded-shell hybrid demo.
# Set to the public RunPod proxy URL of port 8998. When set, the left pane embeds
# the live PersonaPlex UI in an iframe. When unset, the left pane uses the mock
# waveform/transcript flow.
#
# Example:
#   NEXT_PUBLIC_PERSONAPLEX_URL=https://abc123def456-8998.proxy.runpod.net
NEXT_PUBLIC_PERSONAPLEX_URL=

# Optional: drive the demo from canned scenario buttons in the left pane.
# Defaults to "true". Set "false" to hide the scenario picker.
NEXT_PUBLIC_MOCK_MODE=true
